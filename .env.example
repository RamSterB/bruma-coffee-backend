# Puerto HTTP de la API
PORT=8000

# PostgreSQL (contenedor docker postgres16 en la red brumacoffeenet)
DB_HOST=postgres16
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bruma_coffee

# Cifrado de la conexion con la base. En local da igual y se deja en false. En una base
# gestionada **no es opcional**: el servidor rechaza la conexion sin TLS, y las
# credenciales y los datos de las ordenes no deberian viajar en claro.
DB_SSL=false

# El esquema solo se modifica con migraciones versionadas (pnpm m:run).
# DB_SYNCHRONIZE queda en false siempre: synchronize puede borrar datos sin avisar.
DB_SYNCHRONIZE=false

# Ejecuta las migraciones pendientes al arrancar la aplicación
DB_MIGRATIONS_RUN=true

# Orígenes permitidos por CORS, separados por comas. Sin comodines: el comodín
# es inseguro porque la API usa credentials. http:// solo se permite para localhost.
# Si se omite, solo se permite http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cuentas que crea la migracion de arranque. En produccion hay que ponerlas aqui:
# si se dejan los valores de desarrollo, la migracion aborta a proposito.
SEED_ADMIN_EMAIL=admin@bruma-coffee.test
SEED_ADMIN_PASSWORD=BrumaCafe2026!
SEED_CUSTOMER_EMAIL=cliente@bruma-coffee.test
SEED_CUSTOMER_PASSWORD=BrumaCafe2026!

# Secreto con el que se firma el access token. Sin valor por defecto a proposito:
# en produccion sale del almacen de secretos, no de un archivo. Minimo 32
# caracteres. Si falta o es corto, la aplicacion no arranca: es preferible a
# levantar un servicio que responde 401 a todos los logins sin explicar por que.
# Para generar uno: openssl rand -base64 48
JWT_SECRET=

# Vida del access token (15 minutos) y del refresh token (7 dias), en segundos.
# El refresh tambien es la duracion de la cookie, asi que tiene que coincidir.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Coste de bcrypt. 10 es el minimo razonable; subirlo cuesta CPU en cada login.
BCRYPT_ROUNDS=10

# Desglose de la orden. Los tres se leen del entorno porque son decisiones del
# negocio, no del codigo. El IVA va como fraccion: 0.19 es el 19 %.
TAX_RATE=0.19
SHIPPING_FLAT_RATE=10000
FREE_SHIPPING_THRESHOLD=150000

# Pasarela de pago. Las cuatro llaves son obligatorias: sin ellas la aplicacion no
# arranca, porque no hay adaptador simulado. Se releen del panel del proveedor, en
# Developers.
#
# De pruebas hay dos convenciones de prefijo y se aceptan las dos: `pub_test_`,
# `prv_test_`, `test_events_` y `test_integrity_` en la actual, y `pub_stagtest_`,
# `prv_stagtest_`, `stagtest_events_` y `stagtest_integrity_` en la anterior, que es
# la que usa el host UAT. De produccion son `pub_prod_`, `prv_prod_`, `prod_events_`
# y `prod_integrity_`. Las cuatro tienen que ser del mismo ambiente, y la aplicacion
# no arranca si se mezclan.
#
# La llave publica es la unica que puede ir en el navegador: es la que tokeniza la
# tarjeta, y por eso en el frontend va como VITE_CARD_GATEWAY_PUBLIC_KEY. Las otras
# tres se quedan aqui y no salen nunca del servidor.
CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_PRIVATE_KEY=
CARD_GATEWAY_EVENTS_SECRET=
CARD_GATEWAY_INTEGRITY_SECRET=

# URL base de la API de la pasarela. **Es obligatoria y no tiene valor por defecto**, a
# proposito: si faltara, la aplicacion no arranca y lo dice, en vez de cobrar en el
# entorno que le toque por defecto.
#
# Sandbox y produccion son APIs distintas con la misma especificacion, y una no
# entiende las llaves de la otra. El proveedor publica mas de un host y **no todos
# aceptan el mismo ambiente**: se comprobo que el que documenta como principal
# respondia "Formato invalido" a unas llaves de sandbox perfectly valid. Pide el host a
# quien te dio las llaves y comprueba que la combinacion de host y llaves responde antes
# de dar por bueno el despliegue: la aplicacion comprueba el prefijo de las llaves y
# avisa si la combinacion no cuadra, pero no puede saber a que host pertenece cada
# convencion.
CARD_GATEWAY_BASE_URL=

# URL publica de esta aplicacion. Es la que hay que registrar en el panel de la
# pasarela, en Developers -> eventos, para que nos avise del estado de cada cobro.
# La aplicacion la imprime al arrancar, asi que no hay que deducirla ni buscarla.
#
# En produccion es la del balanceador (https://api.tienda.example.com) y tiene que
# ser https: un webhook en http se puede alterar por el camino. En local no hay
# https, asi que para probar el webhook hace falta un tunel y aqui va su URL; cambia
# en cada ejecucion, y por eso es variable y no constante.
PUBLIC_BASE_URL=

